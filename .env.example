# Copy this file to .env and fill in your Trakt credentials.
# Keep the real `.env` out of version control (add to .gitignore).

# Trakt API credentials — create an app at https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID=your_trakt_client_id_here
TRAKT_CLIENT_SECRET=your_trakt_client_secret_here
RPDB_API_KEY=t0-free-rpdb

# Primary user (your account, used by default for local refreshes) - REQUIRED
PRIMARY_USER=your_username_here

# Additional users to display in the app (comma-separated usernames)
# These users' watch history must be public on Trakt.tv
# Example: ADDITIONAL_USERS=petrovgeorgi6,friend1,friend2
ADDITIONAL_USERS=petrovgeorgi6

# Optional overrides (these are the defaults used by the script):
#CACHE_DURATION=3600
#PORT=5000
#FLASK_DEBUG=1
#FLASK_SECRET=your_random_secret_key

# --- Per-user "Log in with Trakt" web login (for rating from the site) ---
# Lets any of PRIMARY_USER/ADDITIONAL_USERS log in with their own Trakt
# account and rate items shown on the site; ratings are saved locally and
# pushed to their real Trakt.tv account via POST /sync/ratings.
#
# 1. Go to https://trakt.tv/oauth/applications and open the app that owns
#    TRAKT_CLIENT_ID/TRAKT_CLIENT_SECRET above.
# 2. Add a Redirect URI matching the value below exactly (scheme+host+port).
#    Trakt allows multiple redirect URIs on one app, so you can add both a
#    local dev one and a production one at the same time.
# 3. Set FLASK_SECRET above to a real random value (required — it now
#    protects login sessions, not just flash messages).
TRAKT_REDIRECT_URI=https://trakt.masoko.net/auth/trakt/callback
