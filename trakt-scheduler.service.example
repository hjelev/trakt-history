[Unit]
Description=Trakt History Update Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=username
WorkingDirectory=/home/username/git/trakt-history
Environment="PATH=/home/username/git/trakt-history/.venv/bin"
ExecStart=/home/username/git/trakt-history/.venv/bin/python /home/username/git/trakt-history/scheduler.py
Restart=always
RestartSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trakt-scheduler

[Install]
WantedBy=multi-user.target
